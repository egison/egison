-- Retained checks of the simpler arithmetic value pattern.
assertEqual "paper/arithmetic-value-accepts"
  (matchAll 7 as something with #(3 + 4) -> 1) [1]
assertEqual "paper/arithmetic-value-rejects"
  (matchAll 8 as something with #(3 + 4) -> 1) []
-- Both uses refer to the same delayed arithmetic expression.
assertEqual "paper/arithmetic-shared"
  (let x := 3 + 4 in (x, x)) (7, 7)

-- Retained checks of the earlier two-branch arithmetic-sharing query.
assertEqual "paper/matchall-whole"
  (let v := 3 + 4 in
    matchAll [7,8] as paperMultiset something with $x :: #v :: _ -> x) [8]
assertEqual "paper/matchall-whole-library"
  (let v := 3 + 4 in
    matchAll [7,8] as multiset something with $x :: #v :: _ -> x) [8]
assertEqual "paper/matchall-whole-miss"
  (let v := 3 + 4 in
    matchAll [8,9] as paperMultiset something with $x :: #v :: _ -> x) []

-- Appendix A: nonlinear matching, catch-all forwarding, and shared target arithmetic.
assertEqual "paper/nonlinear-matchall"
  (matchAll [3 + 4,8,7] as paperMultiset something with
    $x :: #x :: $rs -> (x,rs)) [(7,[8]),(7,[8])]
assertEqual "paper/nonlinear-matchall-library"
  (matchAll [3 + 4,8,7] as multiset something with
    $x :: #x :: $rs -> (x,rs)) [(7,[8]),(7,[8])]
assertEqual "paper/nonlinear-matchall-miss"
  (matchAll [3 + 4,8,9] as paperMultiset something with
    $x :: #x :: $rs -> (x,rs)) []
