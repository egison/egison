-- A closed constructor field still imposes its capability-visible skeleton
-- on an actual primitive-pattern hole producer.  This obligation belongs to
-- the `closedFieldBox $` clause, not to the target type `[Integer]` itself.

inductive ClosedFieldBox := ClosedFieldBox [Integer]
inductive pattern ClosedFieldBox := closedFieldBox [Integer]

-- A matcher may consume a list while exposing no list-pattern capability.
def closedFieldTargetOnly : Matcher Any [Integer] :=
  matcher
    | $ as something with
      | $tgt -> [tgt]

assertEqual "closed field: Any capability with a list target is valid"
  (matchAll [1, 2] as closedFieldTargetOnly with _ -> True)
  [True]

-- The actual producer at the closed list field has a Collection head.
def closedFieldListCapable : Matcher ClosedFieldBox ClosedFieldBox :=
  matcher
    | closedFieldBox $ as list integer with
      | ClosedFieldBox $items -> [items]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "closed field: list-capable hole producer"
  (matchAll (ClosedFieldBox [1, 2]) as closedFieldListCapable with
    | closedFieldBox ($head :: _) -> head)
  [1]

-- An untyped parameter is committed to a MatcherSlot by Step 3a'.  The
-- closed field skeleton constrains that consumer slot to Collection p without
-- strengthening any matcher producer; application then supplies the leaf
-- capability carried by `list integer`.
def closedFieldWith m :=
  matcher
    | closedFieldBox $ as m with
      | ClosedFieldBox $items -> [items]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "closed field: inferred consumer slot receives the list skeleton"
  (matchAll (ClosedFieldBox [1, 2]) as closedFieldWith (list integer) with
    | closedFieldBox ($head :: _) -> head)
  [1]

-- Wildcard and value refinements expose no next-matcher producer, so they do
-- not create the closed-field head obligation.
def closedFieldWildcard : Matcher ClosedFieldBox ClosedFieldBox :=
  matcher
    | closedFieldBox _ as () with
      | ClosedFieldBox $items -> [()]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "closed field: wildcard refinement remains valid"
  (matchAll (ClosedFieldBox [1, 2]) as closedFieldWildcard with
    | closedFieldBox _ -> True)
  [True]

def closedFieldValue : Matcher ClosedFieldBox ClosedFieldBox :=
  matcher
    | closedFieldBox #$expected as () with
      | ClosedFieldBox $actual -> if expected = actual then [()] else []
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "closed field: value refinement remains valid"
  (matchAll (ClosedFieldBox [1, 2]) as closedFieldValue with
    | closedFieldBox #[1, 2] -> True)
  [True]
