def familySum xs := foldl (+) 0 xs
def familyInc x := x+1
def familyIncrements xs := map familyInc xs
assertEqual "scalar sum" (familySum [1,2]) 3
assertEqual "tensor sum" (familySum [[|1,2|],[|3,4|]]) [|4,6|]
assertEqual "scalar increments" (familyIncrements [1,2]) [2,3]
assertEqual "tensor increments" (familyIncrements [[|1,2|],[|3,4|]]) [[|2,3|],[|4,5|]]
assertEqual "independent uses"
  (familySum [1,2],familySum [[|1,2|],[|3,4|]])
  (3,[|4,6|])
assertEqual "local candidates"
  (let f xs := foldl (+) 0 xs in
    (f [1,2], f [[|1,2|],[|3,4|]]))
  (3,[|4,6|])
assertEqual "alias candidates"
  (let f := familySum in (f [1,2],f [[|1,2|],[|3,4|]]))
  (3,[|4,6|])
assertEqual "capture remains in the defining scope"
  (let n := 10 in
    let f xs := map (\x -> x+n) xs in
      let n := True in (f [1,2], f [[|1,2|],[|3,4|]]))
  ([11,12], [[|11,12|],[|13,14|]])
assertEqual "captured scalar callback is shared"
  ((\h -> let f xs := foldl (\a b -> h a b) 0 xs in
    (f [1,2], f [[|1,2|],[|3,4|]])) (+))
  (3,[|4,6|])

assertEqual "curried callback crosses a tensor-valued function result"
  ((\g h -> (g h, tensorMap (\f -> f 10) (h 1)))
    (\k -> k [|1,2|] [|10,20|])
    (\x -> tensor [] [\y -> x+y]))
  ([|11,22|],11)

assertEqual "curried callback preserves a whole tensor argument"
  ((\g h -> (g h, tensorMap (\f -> f [|10,20|]) (h 1)))
    (\k -> k [|1,2|] [|10,20|])
    (\x -> tensor [] [\t -> x + head (tensorShape t)]))
  ([|3,4|],3)

assertEqual "curried callback crosses two tensor-valued function results"
  ((\g h -> (g h, tensorMap (\f -> f 100) (tensorMap (\f -> f 10) (h 1))))
    (\k -> k [|1,2|] [|10,20|] [|100,200|])
    (\x -> tensor [] [\y -> tensor [] [\z -> x+y+z]]))
  ([|111,222|],111)

assertEqual "predicate body retains Bool with tensor arithmetic"
  (filter (\x -> let unused := x+1 in True) [[|1,2|],[|3,4|]])
  [[|1,2|],[|3,4|]]

def familyPredicate x := let unused := x+1 in True
assertEqual "named predicate retains its body conversion"
  (filter familyPredicate [[|1,2|],[|3,4|]])
  [[|1,2|],[|3,4|]]

def familyListShape xs :=
  let shape := tensorShape xs in
    match xs as list something with
      | [] -> shape
      | $first :: $rest -> shape
      else []
assertEqual "later list pattern resolves scalar completion at tensorShape"
  (familyListShape [1,2])
  []

assertEqual "a generic callback does not acquire its input axes"
  ((\k -> tensorShape (k [|1,2|])) (\ignored -> 1))
  []

assertEqual "tensor function results retain scalar callback arguments"
  ((\k -> tensorShape (k 1 2)) (\x -> tensor [] [\y -> x+y]))
  []

assertEqual "a tensor of functions is mapped at the scalar argument position"
  ((\k -> length (tensorShape (k 1))) [| (\x -> x+1), (\x -> x+10) |])
  [|0,0|]
