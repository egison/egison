-- R12 next-matcher component checks: complete inferred types, recursive
-- capability renaming, and the explicit-tuple component boundary.

def keep {a} (x : a) : a := x

inductive Box a := Box (Maybe [a])
inductive pattern Box a := box (Maybe [a])

def boxDirect {a} : Matcher (Box Any) (Box a) :=
  matcher
    | box $ as maybe (list something) with
      | Box $x -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

def boxApplication {a} : Matcher (Box Any) (Box a) :=
  matcher
    | box $ as keep (maybe (list something)) with
      | Box $x -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

def boxLambda {a} : Matcher (Box Any) (Box a) :=
  matcher
    | box $ as (\m -> m) (maybe (list something)) with
      | Box $x -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "next matcher: direct structured value"
  (matchAll (Box (Just [1, 2])) as boxDirect with box $x -> x)
  [Just [1, 2]]

assertEqual "next matcher: structured application"
  (matchAll (Box (Just [1, 2])) as boxApplication with box $x -> x)
  [Just [1, 2]]

assertEqual "next matcher: structured lambda application"
  (matchAll (Box (Just [1, 2])) as boxLambda with box $x -> x)
  [Just [1, 2]]

inductive PairBox := PairBox (Integer, Integer)
inductive pattern PairBox := pairBox (Integer, Integer)

-- There is one hole, so the whole tuple is one product-matcher component.
def pairBoxMatcher : Matcher PairBox PairBox :=
  matcher
    | pairBox $ as (integer, integer) with
      | PairBox $p -> [p]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "next matcher: one-hole product matcher"
  (matchAll (PairBox (1, 2)) as pairBoxMatcher with pairBox ($x, $y) -> (x, y))
  [(1, 2)]

inductive SameBox a := SameBox (a, a)
inductive pattern SameBox a := sameBox (a, a)

-- The lambda duplicates one ground-Any matcher.  Both tuple leaves
-- therefore contribute the same canonical `Any` evidence.
def sameBoxMatcher {a} : Matcher (SameBox Any) (SameBox a) :=
  matcher
    | sameBox $ as (\m -> (m, m)) something with
      | SameBox $p -> [p]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "next matcher: shared variable in product capability"
  (matchAll (SameBox (1, 2)) as sameBoxMatcher with sameBox ($x, $y) -> (x, y))
  [(1, 2)]

inductive UnitBox := UnitBox
inductive pattern UnitBox := unitBox

-- There are no holes, so the explicit empty tuple is the component boundary.
def unitBoxMatcher : Matcher UnitBox UnitBox :=
  matcher
    | unitBox as () with
      | UnitBox -> [()]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "next matcher: zero-hole empty tuple"
  (matchAll UnitBox as unitBoxMatcher with unitBox -> True)
  [True]

-- Lookup supplies an already complete MatcherSlot, exercising the existing
-- slot branch rather than the fresh-variable-to-slot commitment.
def integerSlot : MatcherSlot Any Integer := integer

def headSlot : Matcher [Any] [Integer] :=
  matcher
    | $ :: _ as integerSlot with
      | $x :: _ -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "next matcher: complete existing slot"
  (matchAll [1, 2] as headSlot with $x :: _ -> x)
  [1]

-- Literal consumer Any is a wildcard only at the explicit MatcherSlot
-- boundary, including when it occurs below a fixed capability head.
def acceptAnyListSlot (m : MatcherSlot Any [Integer]) : Bool := True
def acceptNestedAnySlot (m : MatcherSlot [Any] [[Integer]]) : Bool := True

assertEqual "slot coercion: literal consumer Any"
  (acceptAnyListSlot (list integer))
  True

assertEqual "slot coercion: nested literal consumer Any"
  (acceptNestedAnySlot (list (list integer)))
  True
