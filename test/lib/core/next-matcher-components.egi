-- Next-matcher component checks: the next matcher expression of a clause
-- has exactly the matcher type demanded by its holes (one matcher for one
-- hole, a tuple of matchers for several holes, the empty tuple for none).

def keep {a} (x : a) : a := x

inductive Box a := Box (Maybe [a])
inductive pattern Box a := box (Maybe [a])

def boxDirect {a} : Matcher (Box Any) (Box a) :=
  matcher
    | box $ as maybe (list something) with
      | Box $x -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

def boxApplication {a} : Matcher (Box Any) (Box a) :=
  matcher
    | box $ as keep (maybe (list something)) with
      | Box $x -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

def boxLambda {a} : Matcher (Box Any) (Box a) :=
  matcher
    | box $ as (\m -> m) (maybe (list something)) with
      | Box $x -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "next matcher: direct structured value"
  (matchAll (Box (Just [1, 2])) as boxDirect with box $x -> x)
  [Just [1, 2]]

assertEqual "next matcher: structured application"
  (matchAll (Box (Just [1, 2])) as boxApplication with box $x -> x)
  [Just [1, 2]]

assertEqual "next matcher: structured lambda application"
  (matchAll (Box (Just [1, 2])) as boxLambda with box $x -> x)
  [Just [1, 2]]

inductive PairBox := PairBox (Integer, Integer)
inductive pattern PairBox := pairBox (Integer, Integer)

-- There is one hole, so the whole tuple is one product-matcher component.
def pairBoxMatcher : Matcher PairBox PairBox :=
  matcher
    | pairBox $ as (integer, integer) with
      | PairBox $p -> [p]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "next matcher: one-hole product matcher"
  (matchAll (PairBox (1, 2)) as pairBoxMatcher with pairBox ($x, $y) -> (x, y))
  [(1, 2)]

inductive UnitBox := UnitBox
inductive pattern UnitBox := unitBox

-- There are no holes, so the explicit empty tuple is the component boundary.
def unitBoxMatcher : Matcher UnitBox UnitBox :=
  matcher
    | unitBox as () with
      | UnitBox -> [()]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "next matcher: zero-hole empty tuple"
  (matchAll UnitBox as unitBoxMatcher with unitBox -> True)
  [True]

-- A function parameter supplies an already complete matcher; the literal
-- demands exactly its type at the hole.
def headWith integerMatcher :=
  matcher
    | $ :: _ as integerMatcher with
      | $x :: _ -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

def headMatcher : Matcher [Any] [Integer] := headWith integer

assertEqual "next matcher: complete existing matcher parameter"
  (matchAll [1, 2] as headMatcher with $x :: _ -> x)
  [1]

-- A tuple-typed matcher expression fills several holes at once: its type is
-- canonically the tuple of the component matcher types, so an application or
-- a variable of that type is the next matcher of a two-hole clause.
def consFromApplication : Matcher [Any] [Integer] :=
  matcher
    | $ :: $ as keep (integer, list integer) with
      | $x :: $xs -> [(x, xs)]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual "next matcher: application of product matcher type"
  (matchAll [1, 2, 3] as consFromApplication with $x :: $xs -> (x, xs))
  [(1, [2, 3])]

def consFromVariable : Matcher [Any] [Integer] :=
  let ms := (integer, list integer)
   in matcher
        | $ :: $ as ms with
          | $x :: $xs -> [(x, xs)]
          | _ -> []
        | $ as something with
          | $tgt -> [tgt]

assertEqual "next matcher: variable of product matcher type"
  (matchAll [1, 2, 3] as consFromVariable with $x :: $xs -> (x, xs))
  [(1, [2, 3])]
