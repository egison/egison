-- Parameters that flow through arithmetic into a position fixed to Tensor
-- are tensor parameters (design/tensor-demand-propagation.md). The product
-- below is the paper's user-defined `.` without type annotations.
def demandDot u v := contractWith (\x y -> x + y) (u * v)

assertEqual "inner product sums the diagonal"
  (demandDot [|1, 2|]~i [|10, 20|]_i)
  50
assertEqual "matching lower indices keep a componentwise product"
  (demandDot [|1, 2|]_i [|10, 20|]_i)
  [|10, 40|]_i
assertEqual "distinct indices give the tensor product"
  (demandDot [|1, 2|]_i [|10, 20|]_j)
  [|[|10, 20|], [|20, 40|]|]_i_j
assertEqual "matrix product contracts the shared index"
  (demandDot [|[|1, 2|], [|3, 4|]|]_i~j [|[|5, 6|], [|7, 8|]|]_j~k)
  [|[|19, 22|], [|43, 50|]|]_i~k
assertEqual "the product composes through foldl"
  (foldl demandDot [|[|1, 2|], [|3, 4|]|]_i~j [[|[|5, 6|], [|7, 8|]|]_j~k, [|[|1, 0|], [|1, 1|]|]_k~l])
  [|[|41, 22|], [|93, 50|]|]_i~l

-- A parameter inside arithmetic passed to tensorShape receives the tensor whole.
def demandShape x := tensorShape (x + 1)
assertEqual "arithmetic under tensorShape receives the whole tensor"
  (demandShape [|1, 2|])
  [2]

-- Parameters passed bare, literals, and callbacks are not affected.
assertEqual "a bare parameter at a tensor position is unchanged"
  ((\k -> k [|1, 2|]) (\t -> tensorShape t))
  [2]
assertEqual "the scalar fold keeps its ordinary member"
  ((\xs -> foldl (+) 0 xs) [1, 2])
  3
assertEqual "the fold selects its tensor member when required"
  ((\xs -> foldl (+) 0 xs) [[|1, 2|], [|10, 20|]])
  [|11, 22|]
assertEqual "a literal at a map position stays rank zero"
  (tensorMap (\n -> n + 1) 1)
  2
