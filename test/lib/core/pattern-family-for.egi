-- `inductive pattern F a1 ... an for T` declares a pattern family named F
-- whose target type is T.  `Nat` and `Parity` are two families over
-- Integer; `Cartesian` and `Polar` are two families over the data type Cpx,
-- and each of `cart` and `pole` decomposes values of both representations,
-- as in Wadler's views; `Bag` is a family over lists.

-- Peano-style decomposition of Integer

inductive pattern Nat for Integer :=
  | o
  | s Nat

def nat := matcher
  | o as () with
    | 0 -> [()]
    | _ -> []
  | s $ as nat with
    | $n -> if n > 0 then [n - 1] else []
  | #$val as () with
    | $n -> if n = val then [()] else []
  | $ as something with
    | $n -> [n]

def pred n :=
  match n as nat with
    | o -> 0
    | s $m -> m

assertEqual "pred 5" (pred 5) 4
assertEqual "pred 0" (pred 0) 0
assertEqual "s (s o)" (matchAll 2 as nat with s (s o) -> 1) [1]
assertEqual "s (s o) on 3" (matchAll 3 as nat with s (s o) -> 1) []
assertEqual "value pattern under s" (matchAll 3 as nat with s #2 -> 1) [1]
assertEqual "list of nat"
  (matchAll [2, 0, 1] as list nat with _ ++ (s $m) :: _ -> m)
  [1, 0]

-- A second family over Integer

inductive pattern Parity for Integer :=
  | even Integer
  | odd Integer

def parity := matcher
  | even $ as something with
    | $n -> if modulo n 2 = 0 then [quotient n 2] else []
  | odd $ as something with
    | $n -> if modulo n 2 = 1 then [quotient n 2] else []
  | $ as something with
    | $n -> [n]

assertEqual "even" (matchAll 6 as parity with even $k -> k) [3]
assertEqual "odd" (matchAll 7 as parity with odd $k -> k) [3]

-- A field written `Integer` still needs only `something`; a field written
-- `Nat` needs a matcher for the family Nat.

inductive Tagged :=
  | Tagged Integer

inductive pattern Tagged :=
  | tagged Integer

def taggedM := matcher
  | tagged $ as something with
    | Tagged $n -> [n]
  | $ as something with
    | $t -> [t]

inductive Counted :=
  | Counted Integer

inductive pattern Counted :=
  | counted Nat

def countedM := matcher
  | counted $ as nat with
    | Counted $n -> [n]
  | $ as something with
    | $c -> [c]

assertEqual "Integer field" (matchAll Tagged 4 as taggedM with tagged $n -> n) [4]
assertEqual "Nat field" (matchAll Counted 4 as countedM with counted (s $m) -> m) [3]

-- Two families over one data type, as in Wadler's views

inductive Cpx :=
  | Cart Float Float
  | Pole Float Float

inductive pattern Cartesian for Cpx :=
  | cart Float Float

inductive pattern Polar for Cpx :=
  | pole Float Float

def cartesian := matcher
  | cart $ $ as (something, something) with
    | Cart $x $y -> [(x, y)]
    | Pole $r $t -> [(r * f.cos t, r * f.sin t)]
  | $ as something with
    | $z -> [z]

def polar := matcher
  | pole $ $ as (something, something) with
    | Cart $x $y -> [(f.sqrt (x * x + y * y), f.atan2 y x)]
    | Pole $r $t -> [(r, t)]
  | $ as something with
    | $z -> [z]

def cadd z w :=
  match (z, w) as (cartesian, cartesian) with
    | (cart $x1 $y1, cart $x2 $y2) -> Cart (x1 + x2) (y1 + y2)

def cmul z w :=
  match (z, w) as (polar, polar) with
    | (pole $r1 $t1, pole $r2 $t2) -> Pole (r1 * r2) (t1 + t2)

def realPart z :=
  match z as cartesian with
    | cart $x _ -> x

def magnitude z :=
  match z as polar with
    | pole $r _ -> r

assertEqual "Pole decomposed by cart"
  (round (realPart (cmul (Cart 0.0 1.0) (Cart 0.0 1.0))))
  (-1)
assertEqual "Cart decomposed by pole"
  (magnitude (cadd (Cart 1.0 2.0) (Cart 2.0 2.0)))
  5.0
assertEqual "both views through a matcher tuple"
  (matchAll (Cart 3.0 4.0, Cart 3.0 4.0) as (cartesian, polar) with
    (cart $x _, pole $r _) -> (x, r))
  [(3.0, 5.0)]

-- A family over lists with its own name

inductive pattern Bag a for [a] :=
  | empty
  | insert a (Bag a)

def bag m := matcher
  | empty as () with
    | [] -> [()]
    | _ -> []
  | insert $ $ as (m, bag m) with
    | $xs -> matchAll xs as list something with
               $hs ++ $x :: $ts -> (x, hs ++ ts)
  | $ as something with
    | $xs -> [xs]

assertEqual "insert" (matchAll [1, 2, 3] as bag integer with insert $x _ -> x) [1, 2, 3]
assertEqual "insert twice"
  (matchAll [1, 2] as bag integer with insert $x (insert $y empty) -> (x, y))
  [(1, 2), (2, 1)]

-- A parameterized recursive data type with two families: the family of the
-- type with the same name and a family declared with `for` on `Tree a`.  The
-- same programs are checked in the Lean regression ParametricTreeRegression.lean.

inductive Tree a := Leaf a | Node a [Tree a]
inductive pattern Tree a := leaf a | node a [Tree a]
inductive pattern Root a for Tree a := root a

def tree m := matcher
  | leaf $ as m with
    | Leaf $x -> [x]
    | Node _ _ -> []
  | node $ $ as (m, list (tree m)) with
    | Leaf _ -> []
    | Node $x $ts -> [(x, ts)]
  | $ as something with
    | $tgt -> [tgt]

def root m := matcher
  | root $ as m with
    | Leaf $x -> [x]
    | Node $x _ -> [x]
  | $ as something with
    | $tgt -> [tgt]

def treeData := Node 1 [Node 2 [Leaf 3, Leaf 4], Leaf 5, Node 6 [Leaf 3]]

assertEqual "leaves among the children of the root"
  (matchAll treeData as tree something with node _ (_ ++ (leaf $y) :: _) -> y)
  [5]
assertEqual "the two labels above each leaf 3 at depth two"
  (matchAll treeData as tree something with
    node $a (_ ++ (node $b (_ ++ (leaf #3) :: _)) :: _) -> (a, b))
  [(1, 2), (1, 6)]
assertEqual "root of a node" (matchAll treeData as root something with root $x -> x) [1]
assertEqual "root of a leaf" (matchAll Leaf 7 as root something with root $x -> x) [7]
assertEqual "both families through a matcher tuple"
  (matchAll (treeData, treeData) as (tree something, root something) with
    (node $x _, root $r) -> (x, r))
  [(1, 1)]

-- A type parameter of a family declared with `for` may occur nested in the
-- target, outside matcher types.  The family Cells is also checked in the Lean
-- regression ListPatternFamilyRegression.lean.

inductive pattern Cells a for [[a]] := cell a

def cells m := matcher
  | cell $ as m with
    | $xss -> matchAllDFS xss as list (list something) with
                _ ++ (_ ++ $x :: _) :: _ -> x
  | $ as something with
    | $tgt -> [tgt]

assertEqual "any element of any row"
  (matchAll [[1, 2], [3]] as cells something with cell $x -> x)
  [1, 2, 3]

inductive pattern Labels a for Tree [a] := label a

def labels m := matcher
  | label $ as m with
    | Leaf $xs -> xs
    | Node $xs _ -> xs
  | $ as something with
    | $tgt -> [tgt]

assertEqual "any element of the label at the root"
  (matchAll Node [1, 2] [Leaf [3]] as labels something with label $x -> x)
  [1, 2]

-- A type parameter may also occur only inside a matcher type in the target.
-- The family Matchers is also checked in the Lean regression
-- ListPatternFamilyRegression.lean.

inductive pattern Matchers a for [Matcher Any a] := nonempty

def matchers := matcher
  | nonempty as () with
    | _ :: _ -> [()]
    | _ -> []
  | $ as something with
    | $tgt -> [tgt]

assertEqual "a nonempty list of matchers"
  (matchAll [something, something] as matchers with nonempty -> 1)
  [1]
assertEqual "an empty list of matchers"
  (matchAll [] as matchers with nonempty -> 1)
  []
