-- P2 capability/target separation: positive language-level regressions.

def catchAllMatcher {a} : Matcher none a :=
  matcher
    | $ as something with
      | $tgt -> [tgt]

def matcherFor {a} (_ : a) : Matcher none a := catchAllMatcher

assertEqual
  "P2: target specialization preserves none capability"
  (matchAll [1, 2] as catchAllMatcher with
    | $xs -> xs)
  [[1, 2]]

assertEqual
  "P2: function result preserves none capability"
  (matchAll [1, 2] as matcherFor [1, 2] with
    | $xs -> xs)
  [[1, 2]]

assertEqual
  "P2: list lifts the actual element capability"
  (matchAll [1, 2] as list something with
    | $x :: $xs -> (x, xs))
  [(1, [2])]

assertEqual
  "P2: nested combinators preserve capability structure"
  (match Just [1, 2] as maybe (list integer) with
    | just (#1 :: $xs) -> xs
    | _ -> [])
  [2]

inductive P2List a :=
  | P2Nil
  | P2Cons a (P2List a)

inductive pattern P2List a :=
  | p2Nil
  | p2Cons a (P2List a)

def p2List {a} (m : MatcherSlot p a)
  : Matcher (P2List p) (P2List a) :=
  matcher
    | p2Nil as () with
      | P2Nil -> [()]
      | _ -> []
    | p2Cons $ $ as (m, p2List m) with
      | P2Cons $x $xs -> [(x, xs)]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual
  "P2: recursive matcher propagates the input capability"
  (matchAll (P2Cons 1 (P2Cons 2 P2Nil)) as p2List integer with
    | p2Cons $x (p2Cons $y p2Nil) -> (x, y))
  [(1, 2)]

inductive P2Choice a :=
  | P2Left a
  | P2Right a

inductive pattern P2Choice a :=
  | p2Left a
  | p2Right a

-- A partial matcher keeps its structured capability.  Coverage remains an
-- independent optional warning.
def p2LeftOnly {a} (m : MatcherSlot p a)
  : Matcher (P2Choice p) (P2Choice a) :=
  matcher
    | p2Left $ as m with
      | P2Left $x -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual
  "P2: partial matcher retains structured capability"
  (matchAll (P2Left 1) as p2LeftOnly integer with
    | p2Left $x -> x)
  [1]

inductive P2Wrapped a :=
  | P2Wrapped [a]

inductive pattern P2Wrapped a :=
  | p2Wrapped [a]

-- The argument starts with a flexible MatcherSlot capability.  The
-- constructor field signature [a] constrains that capability to [p], and
-- projection carries p to the result without using the target annotation as
-- evidence.
def p2WrappedMatcher m :=
  matcher
    | p2Wrapped $ as m with
      | P2Wrapped $xs -> [xs]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual
  "P2: projection solves a flexible input capability head"
  (match (P2Wrapped [1, 2]) as p2WrappedMatcher (list integer) with
    | p2Wrapped (#1 :: $xs) -> xs
    | _ -> [])
  [2]

inductive P2Atom :=
  | P2Atom Integer

inductive pattern P2Atom :=
  | p2Atom Integer

def p2AtomMatcher : Matcher P2Atom P2Atom :=
  matcher
    | p2Atom $ as integer with
      | P2Atom $n -> [n]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

assertEqual
  "P2: a closed nested pattern keeps its constructor capability"
  (match [P2Atom 1] as list p2AtomMatcher with
    | p2Atom $n :: _ -> n)
  1
