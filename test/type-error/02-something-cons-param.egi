--
-- Match-site capability equality through a function parameter (G-Match, P-Cons).
-- The cons pattern commits `m` to Matcher [p] [Integer]; supplying
-- `something` at the application site fails the capability check there.
--
-- Expected: Type error at `f something` (capability check fails at the
-- application site)
--

def f m := matchAll [1, 2, 3] as m with $x :: $xs -> (x, xs)

def t := f something
