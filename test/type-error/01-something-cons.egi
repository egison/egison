--
-- Match-site capability equality, direct supply (paper rules G-Match and
-- P-Cons).  `something : Matcher Any b` does not have the cons pattern's
-- matcher type `Matcher [p] [Integer]`: `Any` is not the list capability.
--
-- Expected: Type error (Matcher Any b vs Matcher [p] [Integer])
--

def t := matchAll [1, 2, 3] as something with $x :: $xs -> (x, xs)
