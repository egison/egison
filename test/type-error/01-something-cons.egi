--
-- Match-site dual check, direct supply (paper Appendix B, Case 2).
-- `something : Matcher Any b` cannot fill the cons pattern's slot
-- `Matcher [p] [Integer]`: `Any` does not provide list capability.
--
-- Expected: Type error (Matcher Any b vs Matcher [p] [Integer])
--

def t := matchAll [1, 2, 3] as something with $x :: $xs -> (x, xs)
