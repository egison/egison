-- P2 ShapeCap: distinct general clauses that reach the same result slot must
-- agree exactly after already-justified substitutions.

inductive P2Wrap a := P2Wrap a

inductive pattern P2Wrap a :=
  | p2Wrap a

def p2MismatchedClauses :=
  matcher
    | p2Wrap $ as list integer with
      | P2Wrap $xs -> [xs]
      | _ -> []
    | p2Wrap $ as something with
      | P2Wrap $xs -> [xs]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
