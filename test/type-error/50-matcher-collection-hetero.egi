--
-- Heterogeneous matcher collection.  `something : Matcher Any b` and
-- `list integer : Matcher [Any] [Integer]` have different capability
-- heads.  Unifying only their target types must not strengthen
-- `something`; the list literal is rejected.
--
-- Expected: Type error (capability mismatch: Any vs [Any])
--

def t := matchAll [something, list integer] as list something with
  | $m :: _ ->
    matchAll [1, 2] as m with
      | $x :: _ -> x
