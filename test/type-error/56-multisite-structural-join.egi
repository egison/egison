--
-- Multi-site matcher parameter, joint capability demand (a lambda-bound
-- matcher is monomorphic): site 1's cons pattern fixes the parameter's
-- capability to a list capability; the value-pattern-only site 2 adds no
-- demand but does not erase it.  Supplying `something` at the application
-- then fails the capability equation.
--
-- Expected: Type error at `g something` (`Any` against a list head)
--

def g m :=
  ( matchAll [1, 2] as m with $x :: _ -> x
  , matchAll [1, 2] as m with #[1, 2] -> True )

def t := g something
