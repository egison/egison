-- P2 ShapeCap: P2None does not determine the observable parameter of P2Maybe.
-- The result annotation must not fill that missing evidence.

inductive P2Maybe a :=
  | P2None
  | P2Some a

inductive pattern P2Maybe a :=
  | p2None
  | p2Some a

def p2NoneOnly {a} : Matcher (P2Maybe Any) (P2Maybe a) :=
  matcher
    | p2None as () with
      | P2None -> [()]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
