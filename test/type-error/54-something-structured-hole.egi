-- Deferred hole admissibility (paper PP-Con, Def 4.2(1a)): the tail hole of
-- the cons clause requires list capability at its tail hole, where
-- `something` supplies `none`.  The result annotation does not create
-- capability evidence.

def bad : Matcher [none] [Integer] :=
  matcher
    | $ :: $ as (something, something) with
      | $x :: $xs -> [(x, xs)]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
