-- Hole admissibility (paper rules G-Literal and Q-Cons): the tail hole of
-- the cons clause requires list capability at its tail hole, where
-- `something` supplies `Any`.  The result annotation does not create
-- capability evidence.

def bad : Matcher [Any] [Integer] :=
  matcher
    | $ :: $ as (something, something) with
      | $x :: $xs -> [(x, xs)]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
