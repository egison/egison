-- The hole requires `Maybe [p]` capability, whereas `maybe something` has
-- `Maybe Any`.  The ground Any child does not unify with the Collection
-- capability required by the nested list field.
--
-- Expected: Type error (nested list structure is absent from the capability)

inductive Box a := Box (Maybe [a])
inductive pattern Box a := box (Maybe [a])

def bad {a} : Matcher (Box Any) (Box a) :=
  matcher
    | box $ as maybe something with
      | Box $x -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
