--
-- Multi-site matcher parameter, conflicting TARGET types (a lambda-bound
-- matcher is monomorphic): the second match site unifies the same matcher
-- type, so its target type must equal the first site's.  A lambda-bound matcher is
-- monomorphic (standard HM), so [Integer] vs [String] is rejected.
--
-- Expected: Type error at the second match site (Integer vs String)
--

def h m :=
  ( matchAll [1, 2] as m with $x :: _ -> x
  , matchAll ["a", "b"] as m with $y :: _ -> y )
