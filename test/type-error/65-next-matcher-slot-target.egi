-- G-Literal: a next matcher supplied by a parameter must have both indices
-- of the matcher type demanded by the hole.  Its capability `Any` fits the head hole,
-- but its target String does not fit the hole's Integer target.
--
-- Expected: Type error (target mismatch at the hole)

def bad {p} (wrongTargetMatcher : Matcher p String)
  : Matcher [p] [Integer] :=
  matcher
    | $ :: _ as wrongTargetMatcher with
      | $x :: _ -> [x]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
