-- P2 D4 fail-closed boundary: a local alias cannot hide that a next-matcher
-- producer is the definition currently being constructed.  Until recursive
-- producer/path equations are connected to Infer, this flow must be rejected.

inductive P2AliasTree a :=
  | P2AliasLeaf a
  | P2AliasNode (P2AliasTree a)

inductive pattern P2AliasTree a :=
  | p2AliasLeaf a
  | p2AliasNode (P2AliasTree a)

def p2AliasHidden {a}
  : Matcher (P2AliasTree none) (P2AliasTree a) :=
  let hidden := p2AliasHidden
  in matcher
    | p2AliasLeaf $ as something with
      | P2AliasLeaf $value -> [value]
      | _ -> []
    | p2AliasNode $ as hidden with
      | P2AliasNode $rest -> [rest]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
