-- R12 component checking must not skip applications.  keep mPoly has the
-- same complete inferred type Matcher a as mPoly itself.
--
-- Expected: Type error (bare Matcher capability at a list-headed hole)

inductive Box := Box [Integer]
inductive pattern Box := box [Integer]

def keep {a} (x : a) : a := x

def mPoly {a} : Matcher a :=
  matcher
    | $ as something with
      | $tgt -> [tgt]

def bad : Matcher Box :=
  matcher
    | box $ as keep mPoly with
      | Box $xs -> [xs]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
