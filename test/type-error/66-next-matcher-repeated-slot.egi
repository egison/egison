-- The single hole has target (a, a), so signature-directed projection
-- assigns both tuple leaves to the same capability parameter.  The two
-- producers have the same target type but disagree exactly on capability:
-- Choice versus none.  Only `unseen`, not `none`, is neutral during evidence
-- merge, so the repeated assignment must be rejected.
inductive Same a := Same (a, a)
inductive pattern Same a := same (a, a)

inductive Choice := C1 | C2
inductive pattern Choice := c1 | c2

def choice : Matcher Choice Choice :=
  algebraicDataMatcher
    | c1
    | c2

def opaqueChoice : Matcher none Choice :=
  matcher
    | $ as something with
      | $tgt -> [tgt]

def bad : Matcher (Same Choice) (Same Choice) :=
  matcher
    | same $ as (choice, opaqueChoice) with
      | Same $p -> [p]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
