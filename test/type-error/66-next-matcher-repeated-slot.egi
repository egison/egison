-- The single hole has target (a, a), so the declared signature projects both
-- tuple leaves to the same capability parameter.  The two next matchers have
-- the same target type but different capabilities, Choice versus Any, so the
-- capability equation fails.
inductive Same a := Same (a, a)
inductive pattern Same a := same (a, a)

inductive Choice := C1 | C2
inductive pattern Choice := c1 | c2

def choice : Matcher Choice Choice :=
  algebraicDataMatcher
    | c1
    | c2

def opaqueChoice : Matcher Any Choice :=
  matcher
    | $ as something with
      | $tgt -> [tgt]

def bad : Matcher (Same Choice) (Same Choice) :=
  matcher
    | same $ as (choice, opaqueChoice) with
      | Same $p -> [p]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
