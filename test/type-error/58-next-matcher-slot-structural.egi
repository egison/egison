-- G-Literal: a next matcher supplied by a parameter must have both indices
-- of the matcher type required by the pattern hole.  Its target Integer fits the head hole, but its
-- capability `[Any]` does not.
--
-- Expected: Type error (capability mismatch at the hole)

def bad (wrongCapabilityMatcher : Matcher [Any] Integer)
  : Matcher [Any] [Integer] :=
  matcher
    | $ :: $ as (wrongCapabilityMatcher, list integer) with
      | $x :: $xs -> [(x, xs)]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
