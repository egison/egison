-- Algorithm W Step 3a / R12: an existing MatcherSlot component must have
-- both indices checked.  Its target Integer fits the head hole, but its
-- capability `[none]` does not.
--
-- Expected: Type error (slot capability mismatch)

-- A top-level annotation places the complete slot type in the lookup
-- environment before the matcher definition is inferred.
def wrongStructuralSlot : MatcherSlot [none] Integer := undefined

def bad : Matcher [none] [Integer] :=
  matcher
    | $ :: $ as (wrongStructuralSlot, list integer) with
      | $x :: $xs -> [(x, xs)]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
