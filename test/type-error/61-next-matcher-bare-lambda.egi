-- R12 component checking must not skip lambda applications.  This expression
-- has the same complete inferred type `Matcher none a` as mPoly itself.
--
-- Expected: Type error (`none` capability at a list-headed hole)

inductive Box := Box [Integer]
inductive pattern Box := box [Integer]

def mPoly {a} : Matcher none a :=
  matcher
    | $ as something with
      | $tgt -> [tgt]

def bad : Matcher Box Box :=
  matcher
    | box $ as (\m -> m) mPoly with
      | Box $xs -> [xs]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
