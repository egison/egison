-- P2 D4: a recursive use and a structured result annotation are consumer
-- demands, not ShapeCap generation evidence.

inductive P2Tree a :=
  | P2Leaf a
  | P2Node (P2Tree a)

inductive pattern P2Tree a :=
  | p2Leaf a
  | p2Node (P2Tree a)

def p2SeedlessTree {a}
  : Matcher (P2Tree none) (P2Tree a) :=
  matcher
    | p2Node $ as p2SeedlessTree with
      | P2Node $tree -> [tree]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
