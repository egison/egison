--
-- Match site nested inside a matcher body is genuinely checked: `integer`
-- does not have the cons pattern's matcher type in the inner match.
--
-- Expected: Type error (integer vs the cons pattern's matcher type in the
-- inner match)
--

def badInner : Matcher Any [Integer] :=
  matcher
    | $ as something with
      | $tgt ->
        match tgt as integer with
          | $x :: $xs -> [tgt]
          else [tgt]
