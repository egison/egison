-- The list field's hole demands a matcher type with the list capability
-- (G-Literal).  An untyped parameter carries that demand, so rejection of
-- `something` is delayed to this function's application site.
--
-- Expected: Type error (a bare `Any` matcher does not have the list matcher
-- type)

inductive Box := Box [Integer]
inductive pattern Box := box [Integer]

def boxMatcherWith m :=
  matcher
    | box $ as m with
      | Box $items -> [items]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]

def bad := boxMatcherWith something
