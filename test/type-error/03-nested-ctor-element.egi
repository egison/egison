--
-- Nested constructor sub-pattern (paper rule P-Cons applied to the nested
-- constructor).  The element position of the cons is pinned to Tile by
-- `num`, so the element requires Tile capability; `multiset something`
-- provides only `[Any]`.
--
-- Expected: Type error (`[Any]` vs the required `[Tile]` capability)
--

inductive Tile := Num Integer | Hnr Integer
inductive pattern Tile := num Integer | hnr Integer

def t := matchAll [Num 1, Num 2] as multiset something with num $n :: $rest -> n
