-- T-MATCHER / R12 component boundary: a clause with no pattern holes requires
-- the explicit empty next-matcher tuple ().  A matcher value is not an
-- alternative spelling of that zero-component boundary.
--
-- Expected: Type error (zero holes require ())

def bad : Matcher [Any] [Integer] :=
  matcher
    | [] as something with
      | [] -> [()]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
