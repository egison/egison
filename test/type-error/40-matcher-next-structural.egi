--
-- Capability-inadmissible next matcher (paper rules G-Literal and Q-Cons).  The tail pattern hole of the cons
-- matcher clause requires a list capability, which `something` cannot provide; at
-- run time the cons subpattern would be passed to something and raise a runtime
-- error.
--
-- Expected: Type error (`Any` at the list-capable tail hole)
--

def weird {a} (m: Matcher p a) : Matcher [p] [a] :=
  matcher
    | [] as () with
      | [] -> [()]
      | _ -> []
    | $ :: $ as (m, something) with
      | $x :: $xs -> [(x, xs)]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
