--
-- Capability-inadmissible next matcher (paper Appendix B, the `weird`
-- matcher; Definition 4.2(1a) / PP-Con).  The tail hole of the cons
-- clause requires list capability, which `something` cannot fill; the
-- runtime counterpart would route a cons sub-pattern to something and
-- get stuck.
--
-- Expected: Type error (`Any` at the list-capable tail hole)
--

def weird {a} (m: Matcher p a) : Matcher [p] [a] :=
  matcher
    | [] as () with
      | [] -> [()]
      | _ -> []
    | $ :: $ as (m, something) with
      | $x :: $xs -> [(x, xs)]
      | _ -> []
    | $ as something with
      | $tgt -> [tgt]
