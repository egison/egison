def deleteLiteral l cnf :=
  map
    (\c -> matchAll c as multiset integer with
        | ((!#l) & $x) :: _ -> x)
    cnf

def deleteClausesWith l cnf :=
  matchAll cnf as multiset (multiset integer) with
    | ((!(#l :: _)) & $c) :: _ -> c

def assignTrue l cnf := deleteLiteral (neg l) (deleteClausesWith l cnf)

def resolveOn v cnf :=
  matchAll cnf as multiset (multiset integer) with
    | {(#v :: (@ & $xs)) :: (#(neg v) :: (@ & $ys)) :: _,
       !( $l :: _, #(neg l) :: _ )} ->
      unique (xs ++ ys)

def dp vars cnf :=
  match (vars, cnf) as (multiset integer, multiset (multiset integer)) with
  -- satisfiable
  | (_, []) -> True
  -- unsatisfiable
  | (_, [] :: _) -> False
  -- 1-literal rule
  | (_, [$l] :: _) -> dp (delete (abs l) vars) (assignTrue l cnf)
  -- pure literal rule (positive)
  | ($v :: $vs, !((#(neg v) :: _) :: _)) -> dp vs (assignTrue v cnf)
  -- pure literal rule (negative)
  | ($v :: $vs, !((#v :: _) :: _)) -> dp vs (assignTrue (neg v) cnf)
  -- otherwise
  | ($v :: $vs, _) ->
    dp vs
       ((resolveOn v cnf) ++ (deleteClausesWith v (deleteClausesWith (neg v) cnf)))

  | (_, _) -> False

assert "dp" (dp [1] [[1]])
assert "dp" (not (dp [1] [[1], [-1]]))
assert "dp" (dp [1, 2, 3] [[1, 2], [-1, 3], [1, -3]])
assert "dp" (dp [1, 2] [[1, 2], [-1, -2], [1, -2]])
assert "dp" (not (dp [1, 2] [[1, 2], [-1, -2], [1, -2], [-1, 2]]))
assert "dp" (dp [1, 2, 3, 4, 5]
                [[-1, -2, 3], [-1, -2, -3], [1, 2, 3, 4], [-4, -2, 3],
                 [5, 1, 2, -3], [-3, 1, -5], [1, -2, 3, 4], [1, -2, -3, 5]])
assert "dp" (dp [1, 2] [[-1, -2], [1]])

-- The same 52 formulas and four resolution cases as the Lean regressions.
-- Normalize duplicate input literals before applying the elimination rules.
assertEqual "sat/edge/1" (dp [] []) True
assertEqual "sat/edge/2" (dp [] [[]]) False
assertEqual "sat/edge/3" (dp [1] (map unique [[1, -1]])) True
assertEqual "sat/edge/4" (dp [1] (map unique [[1, 1], [-1, -1]])) False
assertEqual "sat/edge/5" (dp [1, 2] (map unique [[1, 2], [2]])) True
assertEqual "sat/edge/6" (dp [1, 2] (map unique [[-1, -2], [-2]])) True
assertEqual "sat/edge/7" (dp [1, 2] (map unique [[1, -1], [2], [-2]])) False
assertEqual "sat/edge/8" (dp [1, 2] (map unique [[1], [1], [-2]])) True
assertEqual "sat/one-variable/1" (dp [1] []) True
assertEqual "sat/one-variable/2" (dp [1] [[]]) False
assertEqual "sat/one-variable/3" (dp [1] (map unique [[1]])) True
assertEqual "sat/one-variable/4" (dp [1] (map unique [[-1]])) True
assertEqual "sat/one-variable/5" (dp [1] (map unique [[1, -1]])) True
assertEqual "sat/one-variable/6" (dp [1] (map unique [[], []])) False
assertEqual "sat/one-variable/7" (dp [1] (map unique [[], [1]])) False
assertEqual "sat/one-variable/8" (dp [1] (map unique [[], [-1]])) False
assertEqual "sat/one-variable/9" (dp [1] (map unique [[], [1, -1]])) False
assertEqual "sat/one-variable/10" (dp [1] (map unique [[1], []])) False
assertEqual "sat/one-variable/11" (dp [1] (map unique [[1], [1]])) True
assertEqual "sat/one-variable/12" (dp [1] (map unique [[1], [-1]])) False
assertEqual "sat/one-variable/13" (dp [1] (map unique [[1], [1, -1]])) True
assertEqual "sat/one-variable/14" (dp [1] (map unique [[-1], []])) False
assertEqual "sat/one-variable/15" (dp [1] (map unique [[-1], [1]])) False
assertEqual "sat/one-variable/16" (dp [1] (map unique [[-1], [-1]])) True
assertEqual "sat/one-variable/17" (dp [1] (map unique [[-1], [1, -1]])) True
assertEqual "sat/one-variable/18" (dp [1] (map unique [[1, -1], []])) False
assertEqual "sat/one-variable/19" (dp [1] (map unique [[1, -1], [1]])) True
assertEqual "sat/one-variable/20" (dp [1] (map unique [[1, -1], [-1]])) True
assertEqual "sat/one-variable/21" (dp [1] (map unique [[1, -1], [1, -1]])) True
assertEqual "sat/binary/1" (dp [1, 2] []) True
assertEqual "sat/binary/2" (dp [1, 2] (map unique [[1, 2]])) True
assertEqual "sat/binary/3" (dp [1, 2] (map unique [[1, -2]])) True
assertEqual "sat/binary/4" (dp [1, 2] (map unique [[1, 2], [1, -2]])) True
assertEqual "sat/binary/5" (dp [1, 2] (map unique [[-1, 2]])) True
assertEqual "sat/binary/6" (dp [1, 2] (map unique [[1, 2], [-1, 2]])) True
assertEqual "sat/binary/7" (dp [1, 2] (map unique [[1, -2], [-1, 2]])) True
assertEqual "sat/binary/8" (dp [1, 2] (map unique [[1, 2], [1, -2], [-1, 2]])) True
assertEqual "sat/binary/9" (dp [1, 2] (map unique [[-1, -2]])) True
assertEqual "sat/binary/10" (dp [1, 2] (map unique [[1, 2], [-1, -2]])) True
assertEqual "sat/binary/11" (dp [1, 2] (map unique [[1, -2], [-1, -2]])) True
assertEqual "sat/binary/12" (dp [1, 2] (map unique [[1, 2], [1, -2], [-1, -2]])) True
assertEqual "sat/binary/13" (dp [1, 2] (map unique [[-1, 2], [-1, -2]])) True
assertEqual "sat/binary/14" (dp [1, 2] (map unique [[1, 2], [-1, 2], [-1, -2]])) True
assertEqual "sat/binary/15" (dp [1, 2] (map unique [[1, -2], [-1, 2], [-1, -2]])) True
assertEqual "sat/binary/16" (dp [1, 2] (map unique [[1, 2], [1, -2], [-1, 2], [-1, -2]])) False
assertEqual "sat/resolution/1" (resolveOn 1 [[1, 2], [-1, 3]]) [[2, 3]]
assertEqual "sat/resolution/2" (resolveOn 1 [[1, 2], [-1, -2]]) []
assertEqual "sat/resolution/3" (resolveOn 1 [[1, 2], [-1, 3, -2]]) []
assertEqual "sat/resolution/4" (resolveOn 1 [[1, 2, 2], [-1, 2, 3]]) [[2, 3]]
