-- Compare readings by value. The Bool records whether a reading was estimated.
instance Eq (Integer, Bool) where
  (==) x y := fst x = fst y
  (/=) x y := not (x == y)

assertEqual "element equality" ((1,True) == (1,False)) True
assertEqual "tensor equality uses the element instance"
  ([|(1,True),(2,False)|] == [|(1,False),(2,True)|]) True
assertEqual "tensor equality checks the last component"
  ([|(1,True),(2,False)|] == [|(1,False),(3,False)|]) False
assertEqual "tensor inequality uses the same element instance"
  ([|(1,True)|] /= [|(1,False)|]) False
assertEqual "singleton on the left" ([|10|] == 10) True
assertEqual "singleton on the right" (10 == [|10|]) True
assertEqual "equal singleton inequality" (10 /= [|10|]) False
assertEqual "unequal singleton component" ([|11|] /= 10) True
assertEqual "a scalar and a vector with repeated components" (10 == [|10,10|]) False
assertEqual "mixed operands use the element instance"
  ((1,True) == [|(1,False)|]) True
assertEqual "one component across two axes" (tensor [1,1] [10] == 10) True
assertEqual "a singleton literal is a scalar" (tensorShape [|10|], typeOf [|10|]) ([], "Integer")
assertEqual "singleton generation uses its original coordinate"
  (generateTensor (\[i,j] -> 9 + i * j) [1,1]) 10
assertEqual "singleton arithmetic returns a scalar" (tensorShape ([|10|] + 1)) []
assertEqual "selection keeps the remaining axis until the last coordinate"
  ((tensor [2,1] [10,20])_2_1, tensorShape ((tensor [2,1] [10,20])_2)) (20, [])
assertEqual "same cells with different shapes"
  (tensor [1,2] [1,2] == tensor [2,1] [1,2]) False
withSymbols [i]
  (assertEqual "same indices and equal components"
    ([|(1,True),(2,True)|]_i == [|(1,False),(2,False)|]_i) True)
withSymbols [i, j]
  (assertEqual "independent indices compare all four pairs"
    ([|1,2|]_i == [|1,2|]_j) False)
withSymbols [i]
  (assertEqual "subscript and superscript"
    ([|1,2|]_i == [|1,2|]~i) True)
withSymbols [i, j]
  (assertEqual "different indices with unequal components"
    ([|1,2|]_i /= [|2,1|]~j) True)

def t1 := [|[|1,2|],[|3,4|]|]
def t2 := [|[|1,3|],[|2,4|]|]
withSymbols [i,j]
  (assertEqual "equality aligns a transposed matrix in both directions"
    (t1_i_j == t2_j_i, t2_j_i == t1_i_j) (True, True))
withSymbols [i,j]
  (assertEqual "an off-diagonal mismatch survives alignment"
    (t1_i_j /= t1_j_i) True)
withSymbols [i,j]
  (assertEqual "independent indices with all pairs equal"
    ([|1,1|]_i == [|1,1|]_j) True)

def rect := tensor [2,3] [1,1,1,1,1,1]
withSymbols [i,j,k]
  (assertEqual "shared index has different lengths despite equal shapes"
    (rect_i_j == rect_k_i, rect_k_i == rect_i_j) (False, False))

def a := tensor [2,3] [1,2,3,4,5,6]
def b := tensor [3,2] [1,4,2,5,3,6]
withSymbols [i,j]
  (assertEqual "rectangular transpose aligns shapes before comparing cells"
    (a_i_j == b_j_i, b_j_i == a_i_j) (True, True))
withSymbols [i,j]
  (assertEqual "assigning both row axes the same index compares unequal lengths"
    (a_i_j == b_i_j) False)
withSymbols [i,j]
  (assertEqual "a changed cell of the rectangular transpose"
    (a_i_j == (tensor [3,2] [1,4,2,5,3,0])_j_i) False)
withSymbols [i,j,k]
  (assertEqual "partly shared indices compare all pairs at each shared coordinate"
    ((tensor [2,3] [1,1,1,2,2,2])_i_j == (tensor [3,2] [1,2,1,2,1,2])_k_i) True)
withSymbols [i,j,k]
  (assertEqual "unmatched axes must also have the same lengths"
    (rect_i_j == (tensor [4,2] [1,1,1,1,1,1,1,1])_k_i) False)
