-- Reference and reconstruction must preserve dimensions after empty axes.
assertEqual "symbolic reference retains trailing dimensions"
  (withSymbols [i] (tensorShape ((tensor [0,3] [])_i))) [0,3]
assertEqual "symbolic reference retains a nonempty outer dimension"
  (withSymbols [i,j] (tensorShape ((tensor [2,0,3] [])_i_j))) [2,0,3]
assertEqual "numeric suffix after empty outer dimension"
  (withSymbols [i] (tensorShape ((tensor [0,3] [])_i_2))) [0]
assertEqual "numeric suffix after two retained dimensions"
  (withSymbols [i,j] (tensorShape ((tensor [2,0,3] [])_i_j_2))) [2,0]
assertEqual "appended symbolic reference retains empty shape"
  (withSymbols [i] (tensorShape ((tensor [0,3] [])..._i))) [0,3]
assertEqual "empty diagonal retains later dimensions"
  (withSymbols [i] (tensorShape ((tensor [0,3,2] [])_i_i))) [0,2]
assertEqual "empty ranges retain the outer dimension"
  (withSymbols [i] (tensorShape ((tensor [0,3] [])_i_(1,2)))) [0,2]
assertEqual "reconstruction retains the number of empty rows"
  (tensorShape [|tensor [0,3] [],tensor [0,3] []|]) [2,0,3]
